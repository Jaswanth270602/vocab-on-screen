<?xml version="1.0" encoding="utf-8"?>
<!-- Keep widget-safe: no negative offsets (many launchers crash on those). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coast_card" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/coast_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#00FFFFFF"
                android:startColor="#66B8E4F8"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="top|end"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/coast_blob" />
        </shape>
    </item>
    <item
        android:width="90dp"
        android:height="90dp"
        android:bottom="0dp"
        android:gravity="bottom|start"
        android:left="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/coast_blob_soft" />
        </shape>
    </item>
</layer-list>
