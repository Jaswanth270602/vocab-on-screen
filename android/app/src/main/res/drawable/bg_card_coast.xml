<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coast_card" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/coast_stroke" />
        </shape>
    </item>
    <!-- Soft sky wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#00FFFFFF"
                android:startColor="#55B8E4F8"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Top-right curve -->
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="top|end"
        android:right="-48dp"
        android:top="-52dp">
        <shape android:shape="oval">
            <solid android:color="@color/coast_blob" />
        </shape>
    </item>
    <!-- Bottom-left curve -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:bottom="-44dp"
        android:gravity="bottom|start"
        android:left="-40dp">
        <shape android:shape="oval">
            <solid android:color="@color/coast_blob_soft" />
        </shape>
    </item>
    <!-- Small accent curve -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center|end"
        android:right="-18dp">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
