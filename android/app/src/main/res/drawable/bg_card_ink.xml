<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_card" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/ink_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#00FFFFFF"
                android:startColor="#44E8D5B5"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="top|end"
        android:right="-48dp"
        android:top="-52dp">
        <shape android:shape="oval">
            <solid android:color="@color/ink_blob" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:bottom="-44dp"
        android:gravity="bottom|start"
        android:left="-40dp">
        <shape android:shape="oval">
            <solid android:color="@color/ink_blob_soft" />
        </shape>
    </item>
</layer-list>
