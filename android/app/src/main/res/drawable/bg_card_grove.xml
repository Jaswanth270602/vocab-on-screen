<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grove_card" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/grove_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#00FFFFFF"
                android:startColor="#5590C4A0"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <solid android:color="@color/grove_blob" />
        </shape>
    </item>
    <item
        android:width="90dp"
        android:height="90dp"
        android:gravity="bottom|start">
        <shape android:shape="oval">
            <solid android:color="@color/grove_blob_soft" />
        </shape>
    </item>
</layer-list>
